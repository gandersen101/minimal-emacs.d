#!/bin/sh
# Install a launchd agent that starts the Emacs daemon at login.
#
# The daemon starts without a frame. Open GUI frames with Emacs Client.app or
# `emacsclient -c`. launchd restarts the daemon after a crash, but not after a
# normal exit such as `kill-emacs' or Cmd-Q. After a normal exit, the next
# `emacsclient -a ""' call starts a daemon, and the agent starts it again at
# the next login.
#
# Usage: bin/install-emacs-daemon [--uninstall]

set -eu

label=org.gnu.emacs.daemon
app=/Applications/Emacs.app
emacs="$app/Contents/MacOS/Emacs"
emacsclient="$app/Contents/MacOS/bin/emacsclient"
plist="$HOME/Library/LaunchAgents/$label.plist"
log="$HOME/Library/Logs/emacs-daemon.log"
domain="gui/$(id -u)"

loaded() {
  launchctl print "$domain/$label" >/dev/null 2>&1
}

if [ "$(uname -s)" != Darwin ]; then
  echo "Refusing: launchd agents are available only on macOS." >&2
  exit 1
fi

case "${1-}" in
  --uninstall)
    if loaded; then
      # launchd sends SIGTERM. Emacs then runs `kill-emacs-hook', which saves
      # the session, but it does not ask about modified buffers.
      launchctl bootout "$domain/$label"
    fi
    rm -f "$plist"
    echo "Removed $label."
    exit 0
    ;;
  "")
    ;;
  *)
    echo "Usage: $0 [--uninstall]" >&2
    exit 2
    ;;
esac

if [ ! -x "$emacs" ] || [ ! -x "$emacsclient" ]; then
  echo "Refusing: $app is missing or incomplete." >&2
  exit 1
fi

if loaded; then
  echo "Refusing: $label is already loaded." >&2
  echo "Save your buffers, then run with --uninstall first. That stops the daemon." >&2
  exit 1
fi

# The server socket is in $TMPDIR/emacs<uid>/. Give the daemon the per-user
# temporary directory that macOS also gives to shells and apps, so that the
# daemon and its clients use the same socket.
tmpdir=$(getconf DARWIN_USER_TEMP_DIR)

# The agent first asks for a running server. If one answers, the agent exits
# successfully and launchd does not try again. This prevents a restart loop
# when a different Emacs owns the server. Without the check, each attempt
# loads the full configuration and then exits with an error.
mkdir -p "$(dirname "$plist")" "$(dirname "$log")"
cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>if "\$0" -w 5 -a false -e t >/dev/null 2>/dev/null; then exit 0; fi; exec "\$1" --fg-daemon</string>
    <string>$emacsclient</string>
    <string>$emacs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TMPDIR</key>
    <string>$tmpdir</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>$HOME</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>$log</string>
  <key>StandardErrorPath</key>
  <string>$log</string>
</dict>
</plist>
EOF
plutil -lint "$plist" >/dev/null

if "$emacsclient" -w 5 -a false -e t >/dev/null 2>&1; then
  echo "Note: a different Emacs server runs now, so the agent exits at once."
  echo "The agent starts the daemon at the next login. To start it earlier, stop"
  echo "that Emacs, then run: launchctl kickstart $domain/$label"
fi

launchctl bootstrap "$domain" "$plist"
echo "Installed $label. The daemon writes its output to $log."
